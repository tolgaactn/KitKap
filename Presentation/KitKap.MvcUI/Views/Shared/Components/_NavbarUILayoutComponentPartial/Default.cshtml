@model NavbarViewModel

<header class="header">
    <div class="header-middle sticky-header">
        <div class="container-fluid">
            <div class="header-left">
                <button class="mobile-menu-toggler pl-0" type="button">
                    <i class="icon-menu"></i>
                </button>
                <a asp-controller="Home" asp-action="Index" class="logo">
                    <img src="~/template/assets/images/Kitkap-logo2.png" alt="KitKap Logo" width="111" height="44">
                </a>
                <nav class="main-nav">
                    <ul class="menu">
                        @{
                            var actionName = ViewContext.RouteData.Values["action"]?.ToString();
                            var controllerName = ViewContext.RouteData.Values["controller"]?.ToString();
                        }

                        <li class="@(actionName == "Index" && controllerName == "Home" ? "active" : "")">
                            <a asp-controller="Home" asp-action="Index">Ana Sayfa</a>
                        </li>

                        <li class="@((actionName == "Index" || actionName == "ProductDetail") && controllerName == "ProductList" ? "active" : "")">
                            <a asp-controller="ProductList" asp-action="Index">Kitaplar</a>
                        </li>

                        <li class="d-none d-lg-block">
                            <a href="#">Kategoriler</a>
                        </li>

                        <li class="d-none d-xl-block"><a href="#">İndirimli Ürünler</a></li>
                        <li class="d-none d-xl-block"><a href="#">Satıcı Ol</a></li>
                    </ul>
                </nav>
            </div>

            <div class="header-right pl-0 pl-lg-4">
                <!-- Arama -->
                <div class="header-search header-search-inline header-search-category w-lg-max text-right d-none d-sm-flex">
                    <a href="#" class="search-toggle" role="button"><i class="icon-magnifier"></i></a>
                    <form asp-controller="ProductList" asp-action="Index" method="get">
                        <div class="header-search-wrapper">
                            <input type="search" class="form-control" name="SearchQuery" id="SearchQuery"
                                   placeholder="Kitap, yazar, yayınevi ara..." required>
                            <button class="btn icon-magnifier" title="Ara" type="submit"></button>
                        </div>
                    </form>
                </div>

                <span class="separator d-none d-lg-inline"></span>

                <!-- ✅ PROFİL DROPDOWN -->
                <div class="dropdown header-dropdown" id="profileDropdown">
                    <a href="#"
                       class="dropdown-toggle"
                       id="profileToggle"
                       role="button"
                       data-bs-toggle="dropdown"
                       aria-haspopup="true"
                       aria-expanded="false">
                        <div class="header-user">
                            <i class="icon-user-2"></i>
                            <div class="header-userinfo">
                                @if (Model.IsSignedIn)
                                {
                                    <span class="d-inline-block font2 line-height-1">Merhaba,</span>
                                    <h4 class="mb-0 user-name">@Model.UserFirstName</h4>
                                }
                                else
                                {
                                    <span class="d-inline-block font2 line-height-1">Giriş Yap</span>
                                    <h4 class="mb-0">Hesabım</h4>
                                }
                            </div>
                        </div>
                    </a>

                    <div class="dropdown-menu dropdown-menu-right" id="profileMenu">
                        @if (Model.IsSignedIn)
                        {
                            <a class="dropdown-item" asp-controller="Account" asp-action="Profile">
                                <i class="fas fa-user"></i> Hesabım
                            </a>
                            <a class="dropdown-item" asp-controller="Account" asp-action="Profile" asp-fragment="orders-tab">
                                <i class="fas fa-shopping-bag"></i> Siparişlerim
                            </a>
                            <a class="dropdown-item" asp-controller="Account" asp-action="Profile" asp-fragment="addresses-tab">
                                <i class="fas fa-map-marker-alt"></i> Adreslerim
                            </a>
                            <div class="dropdown-divider"></div>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="dropdown-form">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item text-danger">
                                    <i class="fas fa-sign-out-alt"></i> Çıkış Yap
                                </button>
                            </form>
                        }
                        else
                        {
                            <a class="dropdown-item" asp-controller="Account" asp-action="Login">
                                <i class="fas fa-sign-in-alt"></i> Giriş Yap
                            </a>
                            <a class="dropdown-item" asp-controller="Account" asp-action="Register">
                                <i class="fas fa-user-plus"></i> Üye Ol
                            </a>
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item" asp-controller="Order" asp-action="TrackOrder">
                                <i class="fas fa-search"></i> Sipariş Takip
                            </a>
                        }
                    </div>
                </div>

                <!-- Favoriler -->
                <a href="#" class="header-icon" title="Favorilerim">
                    <i class="icon-wishlist-2"></i>
                </a>

                <!-- ✅ SEPET DROPDOWN -->
                <div id="shoppingCart" class="dropdown cart-dropdown">
                    <a href="#"
                       title="Sepet"
                       class="dropdown-toggle cart-toggle"
                       role="button"
                       aria-label="Sepet"
                       data-bs-toggle="dropdown"
                       aria-expanded="false">
                        <i class="minicart-icon"></i>
                        @if (Model.Cart.TotalItemCount > 0)
                        {
                            <span class="cart-count badge-circle">@Model.Cart.TotalItemCount</span>
                        }
                    </a>
                    <div class="cart-overlay"></div>
                    <div class="dropdown-menu mobile-cart cart-dropdown-custom">
                        <button class="btn-close" onclick="closeCart()" aria-label="Sepeti Kapat">×</button>
                        <div class="dropdownmenu-wrapper custom-scrollbar">
                            @await Html.PartialAsync("Components/_CartDropdownComponentPartial/Default", Model.Cart)
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</header>