@model KitKap.MvcUI.ViewModels.ProductListViewModels.ProductListPageViewModel

<div class="widget widget-price">
    <h3 class="widget-title">
        <a href="#" data-toggle="collapse" role="button" aria-expanded="true" aria-controls="widget-body-2">
            Fiyat Aralığı
        </a>
    </h3>

    <div class="collapse show" id="widget-body-2">
        <div class="widget-body">
            <form method="get" asp-controller="ProductList" asp-action="Index">
                <div class="price-slider-wrapper">
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small">Min Fiyat</label>
                            <input type="number" 
                                   class="form-control form-control-sm" 
                                   name="MinPrice" 
                                   placeholder="@Model.MinAvailablePrice.ToString("N0")₺"
                                   value="@Model.Filters.MinPrice"
                                   min="@Model.MinAvailablePrice"
                                   max="@Model.MaxAvailablePrice">
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Max Fiyat</label>
                            <input type="number" 
                                   class="form-control form-control-sm" 
                                   name="MaxPrice" 
                                   placeholder="@Model.MaxAvailablePrice.ToString("N0")₺"
                                   value="@Model.Filters.MaxPrice"
                                   min="@Model.MinAvailablePrice"
                                   max="@Model.MaxAvailablePrice">
                        </div>
                    </div>

                    <div class="filter-price-text mb-2">
                        Fiyat: <span class="text-muted">@Model.MinAvailablePrice.ToString("N0")₺ - @Model.MaxAvailablePrice.ToString("N0")₺</span>
                    </div>

                    <!-- Hidden Fields -->
                    <input type="hidden" name="CategoryId" value="@Model.Filters.CategoryId">
                    <input type="hidden" name="Condition" value="@Model.Filters.Condition">
                    <input type="hidden" name="InStockOnly" value="@Model.Filters.InStockOnly">
                    <input type="hidden" name="SortBy" value="@Model.Filters.SortBy">
                    <input type="hidden" name="SearchQuery" value="@Model.Filters.SearchQuery">
                    <input type="hidden" name="PageNumber" value="1">

                    <button type="submit" class="btn btn-primary btn-sm w-100">
                        <i class="icon-sliders"></i> Uygula
                    </button>
                </div>
            </form>

            @if (Model.Filters.MinPrice.HasValue || Model.Filters.MaxPrice.HasValue)
            {
                <div class="mt-2">
                    <a asp-controller="ProductList" 
                       asp-action="Index"
                       asp-route-CategoryId="@Model.Filters.CategoryId"
                       asp-route-MinPrice=""
                       asp-route-MaxPrice=""
                       asp-route-Condition="@Model.Filters.Condition"
                       asp-route-InStockOnly="@Model.Filters.InStockOnly"
                       asp-route-SortBy="@Model.Filters.SortBy"
                       asp-route-SearchQuery="@Model.Filters.SearchQuery"
                       class="btn btn-sm btn-link text-danger p-0">
                        <i class="icon-close"></i> Fiyat Filtresini Temizle
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<!-- Durum Filtresi (Yeni/İkinci El) -->
<div class="widget">
    <h3 class="widget-title">
        <a href="#" data-toggle="collapse" role="button" aria-expanded="true" aria-controls="widget-body-3">
            Ürün Durumu
        </a>
    </h3>

    <div class="collapse show" id="widget-body-3">
        <div class="widget-body">
            <ul class="cat-list">
                <li>
                    <a asp-controller="ProductList" 
                       asp-action="Index"
                       asp-route-CategoryId="@Model.Filters.CategoryId"
                       asp-route-MinPrice="@Model.Filters.MinPrice"
                       asp-route-MaxPrice="@Model.Filters.MaxPrice"
                       asp-route-Condition=""
                       asp-route-InStockOnly="@Model.Filters.InStockOnly"
                       asp-route-SortBy="@Model.Filters.SortBy"
                       asp-route-SearchQuery="@Model.Filters.SearchQuery"
                       class="@(string.IsNullOrEmpty(Model.Filters.Condition) ? "active" : "")">
                        Tümü
                    </a>
                </li>
                <li>
                    <a asp-controller="ProductList" 
                       asp-action="Index"
                       asp-route-CategoryId="@Model.Filters.CategoryId"
                       asp-route-MinPrice="@Model.Filters.MinPrice"
                       asp-route-MaxPrice="@Model.Filters.MaxPrice"
                       asp-route-Condition="New"
                       asp-route-InStockOnly="@Model.Filters.InStockOnly"
                       asp-route-SortBy="@Model.Filters.SortBy"
                       asp-route-SearchQuery="@Model.Filters.SearchQuery"
                       class="@(Model.Filters.Condition == "New" ? "active" : "")">
                        Sıfır Ürün
                    </a>
                </li>
                <li>
                    <a asp-controller="ProductList" 
                       asp-action="Index"
                       asp-route-CategoryId="@Model.Filters.CategoryId"
                       asp-route-MinPrice="@Model.Filters.MinPrice"
                       asp-route-MaxPrice="@Model.Filters.MaxPrice"
                       asp-route-Condition="Used"
                       asp-route-InStockOnly="@Model.Filters.InStockOnly"
                       asp-route-SortBy="@Model.Filters.SortBy"
                       asp-route-SearchQuery="@Model.Filters.SearchQuery"
                       class="@(Model.Filters.Condition == "Used" ? "active" : "")">
                        İkinci El
                    </a>
                </li>
            </ul>
        </div>
    </div>
</div>

<!-- Stok Durumu -->
<div class="widget">
    <h3 class="widget-title">
        <a href="#" data-toggle="collapse" role="button" aria-expanded="true" aria-controls="widget-body-4">
            Stok Durumu
        </a>
    </h3>

    <div class="collapse show" id="widget-body-4">
        <div class="widget-body">
            <div class="custom-control custom-checkbox">
                <input type="checkbox" 
                       class="custom-control-input" 
                       id="instock-checkbox"
                       @(Model.Filters.InStockOnly == true ? "checked" : "")
                       onchange="toggleInStock()">
                <label class="custom-control-label" for="instock-checkbox">
                    Sadece Stokta Olanlar
                </label>
            </div>
        </div>
    </div>
</div>

<script>
    function toggleInStock() {
        var isChecked = document.getElementById('instock-checkbox').checked;
        var url = '@Url.Action("Index", "ProductList", new { 
            CategoryId = Model.Filters.CategoryId,
            MinPrice = Model.Filters.MinPrice,
            MaxPrice = Model.Filters.MaxPrice,
            Condition = Model.Filters.Condition,
            InStockOnly = "__INSTOCK__",
            SortBy = Model.Filters.SortBy,
            SearchQuery = Model.Filters.SearchQuery,
            PageNumber = 1
        })';
        url = url.replace('__INSTOCK__', isChecked ? 'true' : '');
        window.location.href = url;
    }
</script>