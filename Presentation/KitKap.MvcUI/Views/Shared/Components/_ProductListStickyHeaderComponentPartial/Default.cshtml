@model KitKap.MvcUI.ViewModels.ProductListViewModels.ProductListPageViewModel

<nav class="toolbox sticky-header" data-sticky-options="{'mobile': true}">
    <div class="toolbox-left">
        <div class="toolbox-item">
            <span class="text-muted">@Model.TotalProducts ürün listeleniyor</span>
        </div>
    </div>

    <div class="toolbox-right">
        <div class="toolbox-item toolbox-sort">
            <label>Sırala:</label>
            <div class="select-custom">
                <select name="sortby" 
                        class="form-control" 
                        id="sortBySelect"
                        onchange="changeSorting()">
                    <option value="newest" selected="@(Model.Filters.SortBy == "newest")">
                        En Yeniler
                    </option>
                    <option value="price-asc" selected="@(Model.Filters.SortBy == "price-asc")">
                        Fiyat: Düşükten Yükseğe
                    </option>
                    <option value="price-desc" selected="@(Model.Filters.SortBy == "price-desc")">
                        Fiyat: Yüksekten Düşüğe
                    </option>
                    <option value="name-asc" selected="@(Model.Filters.SortBy == "name-asc")">
                        İsim: A-Z
                    </option>
                    <option value="name-desc" selected="@(Model.Filters.SortBy == "name-desc")">
                        İsim: Z-A
                    </option>
                </select>
            </div>
        </div>
    </div>
</nav>

<script>
        function changeSorting() {
        var sortBy = document.getElementById('sortBySelect').value;

        // URL parametrelerini oluştur
        var params = new URLSearchParams();

        if ('@Model.Filters.CategoryId' !== '') params.append('CategoryId', '@Model.Filters.CategoryId');
        if ('@Model.Filters.MinPrice' !== '') params.append('MinPrice', '@Model.Filters.MinPrice');
        if ('@Model.Filters.MaxPrice' !== '') params.append('MaxPrice', '@Model.Filters.MaxPrice');
        if ('@Model.Filters.Condition' !== '') params.append('Condition', '@Model.Filters.Condition');
        if ('@Model.Filters.InStockOnly' === 'True') params.append('InStockOnly', 'true');
        if ('@Model.Filters.SearchQuery' !== '') params.append('SearchQuery', '@Model.Filters.SearchQuery');

        params.append('SortBy', sortBy);
        params.append('PageNumber', '1');

        window.location.href = '/ProductList/Index?' + params.toString();
    }
</script>