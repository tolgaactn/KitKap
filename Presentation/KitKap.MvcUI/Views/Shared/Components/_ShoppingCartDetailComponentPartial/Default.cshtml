<div class="col-lg-4">
	<div class="cart-summary">
		<h3>Sepet Detayları</h3>

		<table class="table table-totals">
			<tbody>
				<tr>
					<td>Toplam</td>
					<td>Adet: <span class="cart-summary-quantity">@TempData["TotalQuantity"]</span></td>
                    <td>Fiyat: <span class="cart-summary-price">@TempData["TotalPrice"]₺</span></td>
				</tr>
				<tr>
					<td colspan="2" class="text-left">
						<h4>Gönderim Türü</h4>

						<div class="form-group form-group-custom-control">
							<div class="custom-control custom-radio">
								<input type="radio" class="custom-control-input" name="radio"
									   checked>
								<label class="custom-control-label">Elden Teslim Alma</label>
							</div><!-- End .custom-checkbox -->
						</div><!-- End .form-group -->

						<div class="form-group form-group-custom-control mb-0">
							<div class="custom-control custom-radio mb-0">
								<input type="radio" name="radio" class="custom-control-input">
								<label class="custom-control-label">Kart ile Tek Çekim</label>
							</div><!-- End .custom-checkbox -->
						</div><!-- End .form-group -->

						<form action="#">
							<div class="form-group form-group-sm">
								<label>Gönderilecek Adres <strong>TR.</strong></label>
								<div class="select-custom">
									<select class="form-control form-control-sm">
										<option value="TR">Türkiye</option>
										<option value="US">Amerika</option>
										<option value="China">Çin</option>
										<option value="Germany">Almanya</option>
									</select>
								</div><!-- End .select-custom -->
							</div><!-- End .form-group -->

							<div class="form-group form-group-sm">
								<div class="select-custom">
									<select class="form-control form-control-sm">
										<option value="IST">İstanbul</option>
										<option value="TKR">Tekirdağ</option>
										<option value="ANK">Ankara</option>
									</select>
								</div><!-- End .select-custom -->
							</div><!-- End .form-group -->

							<div class="form-group form-group-sm">
								<input type="text" class="form-control form-control-sm"
									   placeholder="Şehir / İlçe">
							</div><!-- End .form-group -->

							<div class="form-group form-group-sm">
								<input type="text" class="form-control form-control-sm"
									   placeholder="Posta Kodu">
							</div><!-- End .form-group -->

							<button type="submit" class="btn btn-shop btn-update-total">
								Tümünü Güncelle
							</button>
						</form>
					</td>
				</tr>
			</tbody>

			<tfoot>
				<tr>
					<td>Toplam</td>
					<td colspan="2" class="text-right"><span class="cart-summary-total">@TempData["TotalPrice"]₺</span></td>
				</tr>
			</tfoot>
		</table>

		<div class="checkout-methods">
			<a href="cart.html" class="btn btn-block btn-dark">
				Onayla
				<i class="fa fa-arrow-right"></i>
			</a>
		</div>
	</div><!-- End .cart-summary -->
</div>