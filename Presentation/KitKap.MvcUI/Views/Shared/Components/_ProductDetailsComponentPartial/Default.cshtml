@model ProductDetailViewModel

 
<div class="col-md-6 product-single-details font2">
<form asp-controller="ShoppingCart" asp-action="AddStaySameAction" method="get" id="add-to-cart-form">
<input type="hidden" name="id" value="@Model.Id" /> 
    <h1 class="product-title">@Model.Name</h1>
    <div class="product-nav">
        @if(Model.IsLastProduct)
        {
            <style>
                .custom-before-content:before {
                content: "" !important;
                }
            </style>
            <div class="product-next">
                <a href="@Url.Action("ProductDetail", "ProductList", new { id = Model.PreviousProduct.Id })">
                    <span class="product-link custom-before-content" style="content: '';"></span>
                    <span class="product-popup">
                        <span class="box-content">
                            <img alt="product" width="150" height="150"
                            src="@Model.PreviousProduct.ThumbnailUrl"
                            style="padding-top: 0px;">
                            <span>@Model.PreviousProduct.Name</span>
                        </span>
                    </span>
                </a>
            </div>
        }
        else if (Model.PreviousProduct != null)
        {
            <div class="product-prev">
                <a href="@Url.Action("ProductDetail", "ProductList", new { id = Model.PreviousProduct.Id })">
                    <span class="product-link"></span>
                    <span class="product-popup">
                        <span class="box-content">
                            <img alt="product" width="150" height="150"
                            src="@Model.PreviousProduct.ThumbnailUrl"
                            style="padding-top: 0px;">
                            <span>@Model.PreviousProduct.Name</span>
                        </span>
                    </span>
                </a>
            </div>
        }
        @if (Model.NextProduct != null)
        {
            <div class="product-next">
                <a href="@Url.Action("ProductDetail", "ProductList", new { id = Model.NextProduct.Id })">
                    <span class="product-link"></span>
                    <span class="product-popup">
                        <span class="box-content">
                            <img alt="product" width="150" height="150"
                            src="@Model.NextProduct.ThumbnailUrl"
                            style="padding-top: 0px;">
                            <span>@Model.NextProduct.Name</span>
                        </span>
                    </span>
                </a>
            </div>
        }
    </div>

    <div class="ratings-container">
        <div class="product-ratings">
            <span class="ratings" style="width:80%"></span><!-- End .ratings -->
            <span class="tooltiptext tooltip-top"></span>
        </div><!-- End .product-ratings -->

        <a href="#" class="rating-link">( 6 Reviews )</a>
    </div><!-- End .ratings-container -->

    <hr class="short-divider">

    <div class="price-box">
        <span class="product-price">@Model.Price &#x20BA;</span>
    </div><!-- End .price-box -->

    <div class="product-desc">
        <p>
            @Model.Description
        </p>
    </div><!-- End .product-desc -->

    <ul class="single-info-list">
        <!---->
        <li>
            Stok:
            <strong>
                <a href="#" class="product-category">@Model.Stock</a>
            </strong>
        </li>

        <li>
            Kategori:
            <strong>
                <a href="#" class="product-category">@Model.CategoryName</a>
            </strong>
        </li>

        <li>
            ISBN:
            <strong>@Model.ISBN</strong>
        </li>
    </ul>

    <div class="product-action">
        <div class="product-single-qty">
            <input class="horizontal-quantity form-control" type="number" name="Adet" value="1" min="1" max="@Model.Stock">
        </div><!-- End .product-single-qty -->

        <a href="#" onclick="document.getElementById('add-to-cart-form').submit(); return false;" class="btn btn-dark add-cart icon-shopping-cart mr-2"
           title="Add to Cart">Sepete Ekle</a>

            <a asp-controller="ShoppingCart" asp-action="Index" class="btn btn-gray view-cart @(TempData["AddedToCart"] != null ? "" : "d-none")">Sepeti Görüntüle</a>
    </div><!-- End .product-action -->

    <hr class="divider mb-0 mt-0">

    <div class="product-single-share mb-2">
        <label class="sr-only">Paylaş:</label>

        <div class="social-icons mr-2">
            <a href="#" class="social-icon social-facebook icon-facebook"
               target="_blank" title="Facebook"></a>
            <a href="#" class="social-icon social-twitter icon-twitter"
               target="_blank" title="Twitter"></a>
            <a href="#" class="social-icon social-linkedin fab fa-linkedin-in"
               target="_blank" title="Linkedin"></a>
            <a href="#" class="social-icon social-gplus fab fa-google-plus-g"
               target="_blank" title="Google+"></a>
            <a href="#" class="social-icon social-mail icon-mail-alt"
               target="_blank" title="Mail"></a>
        </div><!-- End .social-icons -->

        <a href="wishlist.html" class="btn-icon-wish add-wishlist"
           title="Add to Wishlist">
            <i class="icon-wishlist-2"></i><span>
                İstek Listene Ekle
            </span>
        </a>
        </div><!-- End .product single-share -->
    </form>
</div>

