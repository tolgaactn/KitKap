@using Kitkap.Service.Dtos.CategoryDtos
@model List<ResultCategoryDto>

<div class="mobile-menu-container">
    <div class="mobile-menu-wrapper">
        <span class="mobile-menu-close"><i class="fa fa-times"></i></span>
        <nav class="mobile-nav">
            <ul class="mobile-menu">
                <li><a asp-controller="Home" asp-action="Index">🏠 Ana Sayfa</a></li>

                <li>
                    <a asp-controller="ProductList" asp-action="Index">📚 Tüm Kitaplar</a>
                </li>

                <li>
                    <a href="#">📂 Kategoriler</a>
                    <ul>
                        @foreach (var category in Model)
                        {
                            <li>
                                <a asp-controller="ProductList"
                                   asp-action="Index"
                                   asp-route-CategoryId="@category.Id">
                                    @category.Name
                                </a>
                            </li>
                        }
                    </ul>
                </li>

                <li>
                    <a asp-controller="Cart" asp-action="Index">🛒 Sepetim</a>
                </li>

                @if (User.Identity.IsAuthenticated)
                {
                    <li>
                        <a asp-controller="Account" asp-action="Profile">👤 Hesabım</a>
                        <ul>
                            <li><a asp-controller="Order" asp-action="MyOrders">Siparişlerim</a></li>
                            <li><a asp-controller="Account" asp-action="Profile">Profilim</a></li>
                            <li><a asp-controller="Account" asp-action="Settings">Ayarlar</a></li>
                            <li><a asp-controller="Account" asp-action="Logout">Çıkış Yap</a></li>
                        </ul>
                    </li>
                }
                else
                {
                    <li><a asp-controller="Account" asp-action="Login">🔐 Giriş Yap</a></li>
                    <li><a asp-controller="Account" asp-action="Register">📝 Kayıt Ol</a></li>
                }
            </ul>

            <ul class="mobile-menu mt-2 mb-2">
                <li class="border-0">
                    <a asp-controller="Home" asp-action="About">ℹ️ Hakkımızda</a>
                </li>
                <li class="border-0">
                    <a asp-controller="Home" asp-action="Contact">📧 İletişim</a>
                </li>
            </ul>
        </nav><!-- End .mobile-nav -->
        <form class="search-wrapper mb-2" asp-controller="ProductList" asp-action="Index" method="get">
            <input type="search"
                   name="SearchQuery"
                   class="form-control mb-0"
                   placeholder="Kitap, yazar, yayınevi ara..."
                   required />
            <button class="btn icon-search text-white bg-transparent p-0" type="submit"></button>
        </form>

        <div class="social-icons">
            <a href="https://www.linkedin.com/in/tolgactn/" class="social-icon" target="_blank" title="LinkedIn">
                <i class="fab fa-linkedin"></i>
            </a>
            <a href="https://github.com/tolgaactn" class="social-icon" target="_blank" title="GitHub">
                <i class="fab fa-github"></i>
            </a>
        </div>
    </div><!-- End .mobile-menu-wrapper -->
</div>