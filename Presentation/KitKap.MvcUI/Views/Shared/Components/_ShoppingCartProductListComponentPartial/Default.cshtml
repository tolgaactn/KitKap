@model ShoppingCartViewModel

@if (Model.Items != null && Model.Items.Count > 0)
{
	@foreach (var order in Model.Items)
	{
		<tr class="fixproduct-row">
			<td>
				<figure class="product-image-container">
					<a asp-controller="ProductList" asp-action="ProductDetail" asp-route-id="@order.ProductId" class="product-image">
						
							<img src="@order.ImageUrl" alt="product">
						
					</a>

					<a asp-controller="ShoppingCart" asp-action="RemoveFromCart" asp-route-id="@order.ProductId" class="btn-remove icon-cancel" title="Ürünü kaldır"></a>
				</figure>
			</td>
			<td class="product-col">
				<h5 class="product-title">
					<a asp-controller="ProductList" asp-action="ProductDetail" asp-route-id="@order.ProductId">@order.ProductName</a>
				</h5>
			</td>
			<td>@order.UnitPrice ₺</td>
			<td>
				<div class="product-single-qty">
					<input class="horizontal-quantity form-control" type="number" value="@order.Quantity" min="1" data-product-id="@order.ProductId">
				</div>
			</td>
			<td class="text-right">
				<span class="subtotal-price">@(order.Quantity* order.UnitPrice) ₺</span>
			</td>
		</tr>
	}
}
else
{
	<tr class="product-row">
		<td colspan="5" class="clearfix">
			<div class="alert alert-primary" role="alert">
				<strong>Sepetiniz boş!</strong>
			</div>
		</td>
	</tr>
}
