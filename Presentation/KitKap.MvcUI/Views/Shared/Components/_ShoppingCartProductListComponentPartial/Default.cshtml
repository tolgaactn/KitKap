@model List<ShoppingCartDetailViewModel>

@if (Model.Count > 0)
{
	@foreach (var order in Model)
	{
		<tr class="fixproduct-row">
			<td>
				<figure class="product-image-container">
					<a asp-controller="ProductList" asp-action="ProductDetail" asp-route-id="@order.productId" class="product-image">
						@foreach (var image in order.ImageUrls)
						{
							<img src="@image" alt="product">
						}													
					</a>

					<a asp-controller="ShoppingCart" asp-action="Delete" asp-route-id="@order.productId" class="btn-remove icon-cancel" title="Remove Product"></a>
				</figure>
			</td>
			<td class="product-col">
				<h5 class="product-title">
					<a asp-controller="ProductList" asp-action="ProductDetail" asp-route-id="@order.productId">@order.productName</a>
				</h5>
			</td>
			<td>@order.productPrice ₺</td>
			<td>				
				<div class="product-single-qty">
					<input class="horizontal-quantity form-control" type="number" value="@order.productQuantity" min="1" data-product-id="@order.productId">
				</div><!-- End .product-single-qty -->
			</td>
			<td class="text-right"><span class="subtotal-price">@(order.productQuantity* order.productPrice) ₺</span></td>
		</tr>
	}
}
else
{
	<tr class="product-row">
		<td colspan="5" class="clearfix">
			<div class="alert alert-primary" role="alert">
				<strong>Sepetiniz boş!</strong>
			</div>
		</td>
	</tr>
	
}