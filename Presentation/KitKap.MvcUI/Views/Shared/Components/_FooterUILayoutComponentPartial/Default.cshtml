<footer class="footer font2">
    <div class="container">
        <div class="footer-middle">
            <div class="row">
                <div class="col-lg-5 mb-1 mb-lg-0">
                    <div class="appear-animate" data-animation-name="fadeInUpShorter"
                    data-animation-delay="200">
                        <a asp-controller="Home" asp-action="Index">
                            <img src="~/template/assets/images/logo-black.png" alt="Logo" width="111"
                            height="44" class="m-b-4">
                        </a>
                    </div>
                    <div class="contact-widget">
                        @foreach (var about in (IEnumerable<AboutViewModel>)ViewBag.About)
