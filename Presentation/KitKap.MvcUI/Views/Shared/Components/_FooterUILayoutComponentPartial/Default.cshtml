                                </div>
                                <div class="col-md-3-5">
                                    <h6 class="text-uppercase mb-0">Ödeme Metodları</h6>
                                    <img src="~/template/assets/images/demoes/demo25/payment.jpg" alt="payment methods"
                                    class="footer-payments m-b-4">
