@model ProductDetailViewModel

<aside class="sidebar-product col-lg-3 mobile-sidebar">
    <div class="sidebar-wrapper">
        <div class="widget widget-info">
            <h3 class="widget-title m-b-3">Satıcı</h3>

            <div class="widget-body bg-gray">
                <h4 class="font2 text-dark line-height-1 m-b-1">@Model.OwnerUserName</h4>
                <p class="font2 font-weight-normal line-height-1 ls-0 text-uppercase">
                    12
                    Kitap
                </p>
                <a href="#" class="d-inline-block text-uppercase">
                    Tüm kitapları gör
                </a>
            </div>
        </div>
        <div class="widget widget-custom">
            <h3 class="widget-title m-b-1">Reklam Alanı</h3>

            <div class="widget-body p-0">
                <h4 class="mb-2">This is a custom sub-title.</h4>
                <p class="font2 text-dark mb-0">
                    Kurumsal ilanlarınız için iletişime geçin.
                </p>
            </div>
        </div>

        <div class="sidebar-banner d-flex justify-content-end"
             style="background-image: url(/template/assets/images/demoes/demo25/banners/banner-sidebar.jpg);background-color: #343339;">
            <div class="banner-layer">
                <h3 class="line-height-1 text-uppercase text-white m-b-1">Yılın Kitapları</h3>
                <p class="font2 line-height-1 mb-2">12 Kitap</p>
                <a href="#" class="btn btn-primary">
                    Koleksiyonu Gör<i class="fas fa-long-arrow-alt-right"></i>
                </a>
            </div>
        </div>
    </div>
</aside>
