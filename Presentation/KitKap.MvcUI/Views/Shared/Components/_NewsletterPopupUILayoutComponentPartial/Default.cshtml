<div class="newsletter-popup mfp-hide bg-img" id="newsletter-popup-form"
     style="background: #f1f1f1 no-repeat center/cover url(/template/assets/images/newsletter_popup_bg.jpg)">
    <div class="newsletter-popup-content">
        <img src="~/template/assets/images/logo-black.png" alt="Logo" class="logo-newsletter" width="111" height="44">
        <h2>Kitkap haber bültenine abone ol</h2>

        <p>
            Kitkap mail listesine abone olun, size özel teklif indirim ve bildirimleri kaçırmayın.
        </p>

        <form action="#">
            <div class="input-group">
                <input type="email" class="form-control" id="newsletter-email" name="newsletter-email"
                       placeholder="Email adresiniz" required />
                <input type="submit" class="btn btn-primary" value="Submit" />
            </div>
        </form>
        <div class="newsletter-subscribe">
            <div class="custom-control custom-checkbox">
                <input type="checkbox" class="custom-control-input" value="0" id="show-again" />
                <label for="show-again" class="custom-control-label">
                    Bu bildirimi bir daha gösterme.
                </label>
            </div>
        </div>
    </div><!-- End .newsletter-popup-content -->

    <button title="Close (Esc)" type="button" class="mfp-close">
        ×
    </button>
</div>