
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_UILayout.cshtml";
}



<main class="main">
	<link rel="stylesheet" href="~/template/assets/css/style.css">

	<div class="container">
		<ul class="checkout-progress-bar d-flex justify-content-center flex-wrap">
			<li class="active">
				<a href="cart.html">Sepetim</a>
			</li>
			<li>
				<a href="checkout.html">Adresler</a>
			</li>
			<li class="disabled">
				<a href="cart.html">Siparişi Tamamla</a>
			</li>
		</ul>

		<div class="row">
			<div class="col-lg-8">
				<div class="cart-table-container">
					<table class="table table-cart">
						<thead>
							<tr>
								<th class="thumbnail-col"></th>
								<th class="product-col">Ürün</th>
								<th class="price-col">Fiyat</th>
								<th class="qty-col">Adet</th>
								<th class="text-right">Toplam</th>
							</tr>
						</thead>
						
						<tbody>
							@await Component.InvokeAsync("_ShoppingCartProductListComponentPartial")
							
						</tbody>


						<tfoot>
							<tr>
								<td colspan="5" class="clearfix">
									@await Component.InvokeAsync("_ShoppingCartDiscountComponentPartial")<!-- End discount .float-left -->

									<div class="float-right">
										<button type="submit" class="btn btn-shop btn-update-cart">
											Update Cart
										</button>
									</div><!-- End .float-right -->
								</td>
							</tr>
						</tfoot>
					</table>
				</div><!-- End .cart-table-container -->
			</div><!-- End .col-lg-8 -->
			@await Component.InvokeAsync("_ShoppingCartDetailComponentPartial") <!-- End cartdetail .col-lg-4 -->
		</div><!-- End .row -->
	</div><!-- End .container -->

	<div class="mb-6"></div><!-- margin -->
</main>