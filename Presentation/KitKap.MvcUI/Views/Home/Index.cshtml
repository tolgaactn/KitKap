@using KitKap.MvcUI.ViewModels.HomeViewModels
@model HomePageViewModel
@{
    ViewData["Title"] = "Ana Sayfa";
    Layout = "~/Views/Shared/_UILayout.cshtml";
}

<main class="main">
    <!-- Kategori Slider -->
    <div class="intro-section">
        <div class="home-slider owl-carousel owl-theme appear-animate" data-owl-options="{
             'lazyLoad' : false,
             'loop' : true,
             'center' : true,
             'navText' : ['<i class=icon-angle-left>', '<i class=icon-angle-right>'],
            'responsive': {
                '576': {
                    'items': 2
                },
                '768': {
                    'items': 3
                }
            }
        }" data-animation-name="fadeIn" data-animation-delay="200">

            @foreach (var slide in Model.CategorySlides)
            {
                    <div class="home-slide">
                        <a asp-controller="ProductList" asp-action="Index" asp-route-CategoryId="@slide.CategoryId">
                            <img src="@slide.ImageUrl" alt="@slide.CategoryName" width="545" height="398">
                            <div class="home-slide-content text-center">
                                <h3 class="ls-n-10 text-white mb-0">@slide.CategoryName</h3>
                                <span class="product-count d-block font2 ls-10 text-uppercase">@slide.ProductCount Ürün</span>
                                <span class="btn text-white">Tüm Ürünleri Gör <i class="fas fa-long-arrow-alt-right"></i></span>
                            </div>
                        </a>

                        @if (slide.FeaturedProduct != null)
                        {
                                <div class="product-default">
                                    <figure>
                                        <img src="@slide.FeaturedProduct.ImageUrl" alt="@slide.FeaturedProduct.Name" width="250" height="375">
                                    </figure>
                                    <div class="product-details">
                                        <h3 class="product-title">
                                            <a asp-controller="ProductList" asp-action="ProductDetail" asp-route-id="@slide.FeaturedProduct.Id">
                                                @slide.FeaturedProduct.Name
                                            </a>
                                        </h3>
                                        <div class="price-box">
                                            <span class="product-price">@slide.FeaturedProduct.Price.ToString("N2")₺</span>
                                        </div>
                                    </div>
                                </div>
                        }
                    </div>
            }
        </div>
    </div>

    <!-- Best Sellers Section -->
    <section class="best-sellers appear-animate" data-animation-name="fadeIn" data-animation-delay="300">
        <div class="container">
            <div class="heading pb-3 mb-2 d-flex align-items-center justify-content-between">
                <h2 class="section-title border-0">En Çok Satan Kitaplar</h2>
                <a asp-controller="ProductList" asp-action="Index" class="btn btn-link">
                    Tüm ürünleri gör<i class="fas fa-long-arrow-alt-right"></i>
                </a>
            </div>

            <div class="row no-gutters m-0">
                <div class="col-md-4">
                    <div class="banner banner1 bg-white">
                        <div class="banner-layer d-flex flex-column align-items-center justify-content-center h-100">
                            <h5 class="font-weight-normal text-uppercase m-b-1"><i>Kitap Kulübü</i></h5>
                            <h2 class="text-center">Sadece en iyi kitaplardan oluşan bir seçki</h2>
                            <figure>
                                <img src="~/template/assets/images/demoes/demo25/banners/banner-1.png" alt="banner" width="343" height="283">
                            </figure>
                            <a asp-controller="ProductList" asp-action="Index" class="btn btn-primary">
                                Kitapları Keşfet <i class="fas fa-long-arrow-alt-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
                <div class="col-md-8">
                    <div class="row custom-products no-gutters">
                        @foreach (var product in Model.BestSellers)
                        {
                            <div class="col-6 col-md-4 col-xl-3">
                                <div class="product-default inner-quickview inner-icon">
                                    <figure>
                                        <a asp-controller="ProductList" asp-action="ProductDetail" asp-route-id="@product.Id">
                                            <img src="@product.ImageUrl" width="217" height="217" alt="@product.Name">
                                        </a>
                                        @if (product.IsHot)
                                        {
                                            <div class="label-group">
                                                <div class="product-label label-hot">POPÜLER</div>
                                            </div>
                                        }
                                        <div class="btn-icon-group">
                                            <a asp-controller="ProductList" asp-action="ProductDetail" asp-route-id="@product.Id"
                                               class="btn-icon btn-add-cart product-type-simple">
                                                <i class="icon-shopping-cart"></i>
                                            </a>
                                        </div>
                                    </figure>
                                    <div class="product-details">
                                        <div class="category-wrap">
                                            <div class="category-list">
                                                <a asp-controller="ProductList" asp-action="Index" asp-route-CategoryId="@product.CategoryName"
                                                   class="product-category">@product.CategoryName</a>
                                            </div>
                                            <a href="#" class="btn-icon-wish"><i class="icon-heart"></i></a>
                                        </div>
                                        <h3 class="product-title">
                                            <a asp-controller="ProductList" asp-action="ProductDetail" asp-route-id="@product.Id">
                                                @product.Name
                                            </a>
                                        </h3>
                                        <div class="price-box">
                                            @if (product.OldPrice.HasValue)
                                            {
                                                <span class="old-price">@product.OldPrice.Value.ToString("N2")₺</span>
                                            }
                                            <span class="product-price">@product.Price.ToString("N2")₺</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Banner Section -->
    <section class="featured-section bg-white">
        <div class="container">
            <div class="row">
                <div class="col-lg-4 m-b-3">
                    <div class="banner banner2 appear-animate"
                         style="background-image: url(~/template/assets/images/demoes/demo25/banners/banner-2.jpg);background-color: #343339;"
                         data-animation-name="fadeInRightShorter" data-animation-delay="200">
                        <div class="banner-layer">
                            <h3 class="text-uppercase text-white m-b-2">Ödüllü Kitaplar</h3>
                            <p class="font2 m-b-3">Özel Seçkiler</p>
                            <a asp-controller="ProductList" asp-action="Index" class="btn btn-primary">
                                Koleksiyonu Gör<i class="fas fa-long-arrow-alt-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 m-b-3">
                    <div class="banner banner3 appear-animate"
                         style="background-image: url(~/template/assets/images/demoes/demo25/banners/banner-3.jpg);background-color: #343436;"
                         data-animation-name="fadeInRightShorter" data-animation-delay="400">
                        <div class="banner-layer">
                            <h3 class="text-uppercase text-white m-b-2">Kitap Fırsatları</h3>
                            <p class="font2 m-b-3">İndirimli Ürünler</p>
                            <a asp-controller="ProductList" asp-action="Index" class="btn btn-secondary">
                                Koleksiyonu Gör<i class="fas fa-long-arrow-alt-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 m-b-5">
                    <div class="banner banner4 appear-animate"
                         style="background-image: url(~/template/assets/images/demoes/demo25/banners/banner-4.jpg);background-color: #343436;"
                         data-animation-name="fadeInRightShorter" data-animation-delay="600">
                        <div class="banner-layer">
                            <h3 class="text-uppercase text-white m-b-2">En Çok Hediye Edilen</h3>
                            <p class="font2 m-b-3">Popüler Kitaplar</p>
                            <a asp-controller="ProductList" asp-action="Index" class="btn btn-teritary">
                                Koleksiyonu Gör<i class="fas fa-long-arrow-alt-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Featured Books -->
            <div class="appear-animate" data-animation-name="fadeInUpShorter" data-animation-delay="200">
                <h2 class="section-title pb-3 mb-2">Öne Çıkan Kitaplar</h2>

                <div class="row">
                    @foreach (var product in Model.FeaturedBooks)
                    {
                        <div class="col-6 col-md-4 col-lg-3 col-xl-2">
                            <div class="product-default inner-quickview inner-icon">
                                <figure>
                                    <a asp-controller="ProductList" asp-action="ProductDetail" asp-route-id="@product.Id">
                                        <img src="@product.ImageUrl" width="217" height="217" alt="@product.Name">
                                    </a>
                                    @if (product.IsHot)
                                    {
                                        <div class="label-group">
                                            <div class="product-label label-hot">POPÜLER</div>
                                        </div>
                                    }
                                    <div class="btn-icon-group">
                                        <a asp-controller="ProductList" asp-action="ProductDetail" asp-route-id="@product.Id"
                                           class="btn-icon btn-add-cart product-type-simple">
                                            <i class="icon-shopping-cart"></i>
                                        </a>
                                    </div>
                                </figure>
                                <div class="product-details">
                                    <div class="category-wrap">
                                        <div class="category-list">
                                            <a asp-controller="ProductList" asp-action="Index"
                                               class="product-category">@product.CategoryName</a>
                                        </div>
                                        <a href="#" title="Favorilere Ekle" class="btn-icon-wish">
                                            <i class="icon-heart"></i>
                                        </a>
                                    </div>
                                    <h3 class="product-title">
                                        <a asp-controller="ProductList" asp-action="ProductDetail" asp-route-id="@product.Id">
                                            @product.Name
                                        </a>
                                    </h3>
                                    <div class="price-box">
                                        <span class="product-price">@product.Price.ToString("N2")₺</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>

    <!-- Promo Section -->
    <section class="promo-section bg-primary"
             style="background-image: url(~/template/assets/images/demoes/demo25/banners/banner-5.png)">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-10 col-sm-7 col-lg-5 mb-2 mb-lg-0 appear-animate"
                     data-animation-name="fadeInLeftShorter" data-animation-delay="200">
                    <h5 class="font-weight-normal text-uppercase mb-0"><i>Yılda Bir Kez</i></h5>
                    <div class="d-inline-block">
                        <h2 class="ls-n-10 text-white mb-0">299₺ Üzeri Alışverişlerde %30 İndirim</h2>
                        <p class="font2 text-right text-uppercase text-white mb-0">* Seçili kitaplarda</p>
                    </div>
                </div>
                <div class="col-7 col-lg-3 appear-animate" data-animation-name="fadeInLeftShorter"
                     data-animation-delay="500">
                    <a asp-controller="ProductList" asp-action="Index" class="btn btn-quaternary">
                        Kitapları Keşfet <i class="fas fa-long-arrow-alt-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Recent Books Section -->
    <section class="recent-section appear-animate" data-animation-name="fadeIn" data-animation-delay="200">
        <div class="container">
            <h2 class="section-title pb-3 mb-2">Yeni Eklenen Kitaplar</h2>

            <div class="row">
                @foreach (var product in Model.RecentBooks)
                {
                    <div class="col-6 col-md-4 col-lg-3 col-xl-2">
                        <div class="product-default inner-quickview inner-icon">
                            <figure>
                                <a asp-controller="ProductList" asp-action="ProductDetail" asp-route-id="@product.Id">
                                    <img src="@product.ImageUrl" width="217" height="217" alt="@product.Name">
                                </a>
                                <div class="btn-icon-group">
                                    <a asp-controller="ProductList" asp-action="ProductDetail" asp-route-id="@product.Id"
                                       class="btn-icon btn-add-cart product-type-simple">
                                        <i class="icon-shopping-cart"></i>
                                    </a>
                                </div>
                            </figure>
                            <div class="product-details">
                                <div class="category-wrap">
                                    <div class="category-list">
                                        <a asp-controller="ProductList" asp-action="Index"
                                           class="product-category">@product.CategoryName</a>
                                    </div>
                                    <a href="#" title="Favorilere Ekle" class="btn-icon-wish">
                                        <i class="icon-heart"></i>
                                    </a>
                                </div>
                                <h3 class="product-title">
                                    <a asp-controller="ProductList" asp-action="ProductDetail" asp-route-id="@product.Id">
                                        @product.Name
                                    </a>
                                </h3>
                                <div class="price-box">
                                    <span class="product-price">@product.Price.ToString("N2")₺</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- Newsletter Section -->
    <section class="newsletter-section bg-white text-center appear-animate" data-animation-name="fadeIn"
             data-animation-delay="200">
        <div class="container">
            <p class="text-dark m-b-2"><i class="far fa-envelope"></i></p>
            <h2 class="ls-n-10 mb-0">Bültenimize Abone Olun</h2>
            <h5 class="font-weight-normal text-body m-b-4">
                Tüm etkinlikler, kampanyalar ve fırsatlardan haberdar olun.
            </h5>
            <form class="newsletter-form" action="#" method="get">
                <input type="email" class="form-control font2 mb-0" placeholder="E-posta adresinizi girin..." required>
                <button type="submit" class="btn btn-submit text-white">Abone Ol</button>
            </form>
        </div>
    </section>
</main>