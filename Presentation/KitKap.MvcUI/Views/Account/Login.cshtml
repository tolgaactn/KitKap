@model LoginViewModel
@{
    ViewData["Title"] = "Giriş Yap";
}

<main class="main">
    <div class="page-header">
        <div class="container d-flex flex-column align-items-center">
            <nav aria-label="breadcrumb" class="breadcrumb-nav">
                <div class="container">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Ana Sayfa</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Giriş Yap</li>
                    </ol>
                </div>
            </nav>

            <h1>Hesabınıza Giriş Yapın</h1>
        </div>
    </div>

    <div class="container login-container">
        <div class="row">
            <div class="col-lg-10 mx-auto">
                <div class="row">
                    <!-- ✅ SOL: GİRİŞ FORMU -->
                    <div class="col-md-6">
                        <div class="heading mb-1">
                            <h2 class="title">Giriş Yap</h2>
                        </div>

                        <form asp-action="Login" method="post">
                            @Html.AntiForgeryToken()

                            <!-- ✅ ReturnUrl Hidden Field -->
                            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                            <!-- ✅ Hata Mesajları - SADECE HATA VARSA GÖSTER -->
                            @if (!ViewData.ModelState.IsValid)
                            {
                                <div class="alert alert-danger" role="alert">
                                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                                </div>
                            }

                            <!-- Email -->
                            <label asp-for="Email">
                                E-posta Adresi *
                            </label>
                            <input asp-for="Email" type="email" class="form-input form-wide mb-2" required />
                            <span asp-validation-for="Email" class="text-danger"></span>

                            <!-- Password -->
                            <label asp-for="Password">
                                Şifre *
                            </label>
                            <input asp-for="Password" type="password" class="form-input form-wide mb-2" required />
                            <span asp-validation-for="Password" class="text-danger"></span>

                            <!-- Remember Me & Forgot Password -->
                            <div class="form-footer mb-2">
                                <div class="custom-control custom-checkbox mb-0">
                                    <input asp-for="RememberMe" type="checkbox" class="custom-control-input" id="lost-password" />
                                    <label asp-for="RememberMe" class="custom-control-label mb-0" for="lost-password">Beni Hatırla</label>
                                </div>

                                <a asp-action="ForgotPassword" class="forget-password text-dark form-footer-right">
                                    Şifremi Unuttum
                                </a>
                            </div>

                            <button type="submit" class="btn btn-dark btn-md w-100">
                                GİRİŞ YAP
                            </button>
                        </form>
                    </div>

                    <!-- ✅ SAĞ: KAYIT OL -->
                    <div class="col-md-6">
                        <div class="heading mb-1">
                            <h2 class="title">Hesabınız Yok mu?</h2>
                        </div>

                        <p>Kayıt olarak şu avantajlardan yararlanın:</p>

                        <ul class="check-list">
                            <li><i class="icon-check"></i> Hızlı ve kolay alışveriş</li>
                            <li><i class="icon-check"></i> Sipariş takibi</li>
                            <li><i class="icon-check"></i> Özel kampanyalar ve indirimler</li>
                            <li><i class="icon-check"></i> Favori listeniz</li>
                            <li><i class="icon-check"></i> Adres kaydetme</li>
                        </ul>

                        <a asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]" class="btn btn-primary btn-md">
                            HESAP OLUŞTUR
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}