@model RegisterViewModel
@{
    ViewData["Title"] = "Kayıt Ol";
}

<main class="main">
    <div class="page-header">
        <div class="container d-flex flex-column align-items-center">
            <nav aria-label="breadcrumb" class="breadcrumb-nav">
                <div class="container">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Ana Sayfa</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Kayıt Ol</li>
                    </ol>
                </div>
            </nav>

            <h1>Yeni Hesap Oluşturun</h1>
        </div>
    </div>

    <div class="container register-container">
        <div class="row">
            <div class="col-lg-8 mx-auto">
                <div class="heading mb-3">
                    <h2 class="title">Kişisel Bilgileriniz</h2>
                    <p class="text-muted">Hesap oluşturmak için lütfen aşağıdaki bilgileri doldurun.</p>
                </div>

                <form asp-action="Register" method="post">
                    @Html.AntiForgeryToken()

                    <!-- ✅ ReturnUrl Hidden Field -->
                    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                    <!-- ✅ Hata Mesajları - SADECE HATA VARSA GÖSTER -->
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger" role="alert">
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        </div>
                    }

                    <div class="row">
                        <!-- Ad -->
                        <div class="col-md-6">
                            <label asp-for="FirstName">
                                Ad *
                            </label>
                            <input asp-for="FirstName" type="text" class="form-input form-wide mb-3" required />
                            <span asp-validation-for="FirstName" class="text-danger"></span>
                        </div>

                        <!-- Soyad -->
                        <div class="col-md-6">
                            <label asp-for="LastName">
                                Soyad *
                            </label>
                            <input asp-for="LastName" type="text" class="form-input form-wide mb-3" required />
                            <span asp-validation-for="LastName" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Kullanıcı Adı -->
                    <label asp-for="UserName">
                        Kullanıcı Adı *
                    </label>
                    <input asp-for="UserName" type="text" class="form-input form-wide mb-3" required />
                    <span asp-validation-for="UserName" class="text-danger"></span>

                    <!-- Email -->
                    <label asp-for="Email">
                        E-posta Adresi *
                    </label>
                    <input asp-for="Email" type="email" class="form-input form-wide mb-3" required />
                    <span asp-validation-for="Email" class="text-danger"></span>

                    <!-- Şifre -->
                    <label asp-for="Password">
                        Şifre *
                    </label>
                    <input asp-for="Password" type="password" class="form-input form-wide mb-3" required />
                    <span asp-validation-for="Password" class="text-danger"></span>

                    <!-- Şifre Onay -->
                    <label asp-for="ConfirmPassword">
                        Şifre Tekrar *
                    </label>
                    <input asp-for="ConfirmPassword" type="password" class="form-input form-wide mb-3" required />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>

                    <!-- Kullanıcı Sözleşmesi -->
                    <div class="form-group mb-3">
                        <div class="custom-control custom-checkbox">
                            <input type="checkbox" class="custom-control-input" id="terms" required />
                            <label class="custom-control-label" for="terms">
                                <a href="#" class="text-primary">Kullanıcı Sözleşmesi</a>'ni okudum ve kabul ediyorum. *
                            </label>
                        </div>
                    </div>

                    <!-- KVKK -->
                    <div class="form-group mb-4">
                        <div class="custom-control custom-checkbox">
                            <input type="checkbox" class="custom-control-input" id="kvkk" />
                            <label class="custom-control-label" for="kvkk">
                                Kampanya ve yeniliklerden haberdar olmak istiyorum.
                            </label>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary btn-md w-100 mb-3">
                        HESAP OLUŞTUR
                    </button>

                    <div class="text-center">
                        <span class="text-muted">Zaten hesabınız var mı?</span>
                        <a asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" class="text-primary font-weight-bold">
                            Giriş Yapın
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}