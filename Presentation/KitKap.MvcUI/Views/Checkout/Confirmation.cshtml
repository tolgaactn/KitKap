@model KitKap.MvcUI.ViewModels.CheckoutViewModels.OrderConfirmationViewModel
@{
    ViewData["Title"] = "Sipariş Durumu";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            @* Duruma göre mesaj *@
            @if (Model.Transaction?.Status == Kitkap.Entity.Entities.Transaction.PaymentStatus.Completed)
            {
                <!-- ✅ BAŞARILI -->
                <div class="text-center mb-5">
                    <i class="fas fa-check-circle text-success" style="font-size: 80px;"></i>
                    <h2 class="mt-4">Siparişiniz Başarıyla Alındı! 🎉</h2>
                    <p class="text-muted">Ödemeniz onaylandı, siparişiniz hazırlanıyor.</p>
                </div>
            }
            else if (Model.Transaction?.Status == Kitkap.Entity.Entities.Transaction.PaymentStatus.Failed)
            {
                <!-- ❌ BAŞARISIZ -->
                <div class="text-center mb-5">
                    <i class="fas fa-times-circle text-danger" style="font-size: 80px;"></i>
                    <h2 class="mt-4">Ödeme Başarısız</h2>
                    <p class="text-muted">Ödemeniz gerçekleştirilemedi. Lütfen tekrar deneyin.</p>
                </div>
            }
            else
            {
                <!-- ⏳ BEKLEMEDE (Havale/EFT) -->
                <div class="text-center mb-5">
                    <i class="fas fa-clock text-warning" style="font-size: 80px;"></i>
                    <h2 class="mt-4">Siparişiniz Alındı!</h2>
                    <p class="text-muted">Ödeme onayı bekleniyor. Havale/EFT işleminizi tamamlayınız.</p>
                </div>
            }

            <!-- Sipariş Bilgileri Card -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-info-circle me-2"></i>Sipariş Bilgileri</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <strong>Sipariş No:</strong><br>
                            <span class="text-primary fs-5">#@Model.Order.Id</span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <strong>Sipariş Tarihi:</strong><br>
                            @(Model.Order.CreatedAt?.ToString("dd MMMM yyyy HH:mm") ?? "Bilinmiyor")
                        </div>
                        <div class="col-md-6">
                            <strong>Ödeme Yöntemi:</strong><br>
                            @Model.Order.PaymentMethodText
                        </div>
                        <div class="col-md-6">
                            <strong>Toplam Tutar:</strong><br>
                            <span class="text-success fs-4 fw-bold">@Model.Order.TotalAmount.ToString("N2") ₺</span>
                        </div>
                    </div>
                </div>
            </div>

            @* Havale/EFT için banka bilgileri *@
            @if (Model.Order.PaymentMethod == "BankTransfer" &&
                        Model.Transaction?.Status != Kitkap.Entity.Entities.Transaction.PaymentStatus.Failed)
            {
                <div class="alert alert-warning">
                    <h5><i class="fas fa-university me-2"></i>Banka Hesap Bilgileri</h5>
                    <hr>
                    <div class="row">
                        <div class="col-md-6">
                            <p class="mb-2"><strong>Banka:</strong> Ziraat Bankası</p>
                            <p class="mb-2"><strong>Hesap Sahibi:</strong> KitKap E-Ticaret Ltd. Şti.</p>
                        </div>
                        <div class="col-md-6">
                            <p class="mb-2"><strong>IBAN:</strong> TR00 0000 0000 0000 0000 0000 00</p>
                            <p class="mb-2"><strong>Açıklama:</strong> <span class="badge bg-danger">Sipariş No: #@Model.Order.Id</span></p>
                        </div>
                    </div>
                    <div class="alert alert-danger mt-3 mb-0">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <strong>ÖNEMLİ:</strong> Ödeme açıklamasına mutlaka sipariş numaranızı yazınız!
                    </div>
                </div>
            }

            @* Sipariş detayları *@
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0"><i class="fas fa-box me-2"></i>Sipariş Detayları</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Ürün</th>
                                    <th class="text-center">Adet</th>
                                    <th class="text-end">Birim Fiyat</th>
                                    <th class="text-end">Toplam</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Order.Items)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                @if (!string.IsNullOrEmpty(item.ProductImageUrl))
                                                {
                                                    <img src="@item.ProductImageUrl" alt="@item.ProductName"
                                                         class="me-3" style="width: 50px; height: 70px; object-fit: cover;">
                                                }
                                                <strong>@item.ProductName</strong>
                                            </div>
                                        </td>
                                        <td class="text-center align-middle">@item.Quantity</td>
                                        <td class="text-end align-middle">@item.UnitPrice.ToString("N2") ₺</td>
                                        <td class="text-end align-middle"><strong>@item.TotalPrice.ToString("N2") ₺</strong></td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-light">
                                <tr>
                                    <td colspan="3" class="text-end"><strong>Ara Toplam:</strong></td>
                                    <td class="text-end">@Model.Order.SubTotal.ToString("N2") ₺</td>
                                </tr>
                                <tr>
                                    <td colspan="3" class="text-end"><strong>Kargo:</strong></td>
                                    <td class="text-end">@Model.Order.ShippingCost.ToString("N2") ₺</td>
                                </tr>
                                <tr class="table-success">
                                    <td colspan="3" class="text-end"><h5 class="mb-0">Genel Toplam:</h5></td>
                                    <td class="text-end"><h5 class="mb-0 text-success">@Model.Order.TotalAmount.ToString("N2") ₺</h5></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Order.CustomerNote))
                    {
                        <div class="alert alert-info mt-3 mb-0">
                            <strong><i class="fas fa-sticky-note me-2"></i>Sipariş Notu:</strong><br>
                            @Model.Order.CustomerNote
                        </div>
                    }
                </div>
            </div>

            @* Teslimat adresi *@
            @if (!string.IsNullOrEmpty(Model.Order.ShippingAddressText))
            {
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0"><i class="fas fa-map-marker-alt me-2"></i>Teslimat Adresi</h5>
                    </div>
                    <div class="card-body">
                        <p class="mb-0">@Model.Order.ShippingAddressText</p>
                    </div>
                </div>
            }

            <!-- Butonlar -->
            <div class="text-center mt-4">
                @if (Model.Transaction?.Status != Kitkap.Entity.Entities.Transaction.PaymentStatus.Failed)
                {
                    <a asp-controller="Account" asp-action="MyOrders" class="btn btn-primary btn-lg me-2">
                        <i class="fas fa-list me-2"></i>Siparişlerime Git
                    </a>
                }
                else
                {
                    <a asp-controller="Checkout" asp-action="Index" class="btn btn-warning btn-lg me-2">
                        <i class="fas fa-redo me-2"></i>Tekrar Dene
                    </a>
                }
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-lg">
                    <i class="fas fa-shopping-bag me-2"></i>Alışverişe Devam
                </a>
            </div>

            @* Bilgilendirme *@
            <div class="alert alert-light text-center mt-4 border">
                <i class="fas fa-envelope me-2"></i>
                Sipariş detaylarınız e-posta adresinize gönderilmiştir.
            </div>

        </div>
    </div>
</div>