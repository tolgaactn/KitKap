@model CategoryViewModel

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<!-- main-content-wrap -->
<div class="main-content-inner">
    <!-- main-content-wrap -->
    <div class="main-content-wrap">
        <div class="flex items-center flex-wrap justify-between gap20 mb-27">
            <h3>Kategori Düzenle</h3>
            <ul class="breadcrumbs flex items-center flex-wrap justify-start gap10">
                <li>
                    <a href="/Admin/AdminHome/Index"><div class="text-tiny">Anasayfa</div></a>
                </li>
                <li>
                    <i class="icon-chevron-right"></i>
                </li>
                <li>
                    <a href="#"><div class="text-tiny">Kategori</div></a>
                </li>
                <li>
                    <i class="icon-chevron-right"></i>
                </li>
                <li>
                    <div class="text-tiny">Kategori Listesi</div>
                </li>
            </ul>
        </div>
        <!-- new-attribute -->
        <div class="wg-box">
            <form class="form-new-product form-style-1" asp-action="Edit" asp-controller="Category" asp-area="Admin" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <fieldset class="name">
                    <div class="body-title">Id <span class="tf-color-1">*</span> </div>
                    <input class="flex-grow" asp-for="Id" type="text" tabindex="0">
                    <span asp-validation-for="Id" class="text-danger"></span>
                </fieldset>
                <fieldset class="name">
                    <div class="body-title">Kategori Adı <span class="tf-color-1">*</span> </div>
                    <input class="flex-grow" asp-for="Name" type="text" tabindex="0">
                    <span asp-validation-for="Name" class="text-danger"></span>
                </fieldset>
                <fieldset class="name">
                    <div class="body-title">Açıklama <span class="tf-color-1">*</span> </div>
                    <textarea class="flex-grow" asp-for="Description" placeholder="Açıklama" tabindex="0" aria-required="true" required=""></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </fieldset>
                <fieldset class="name">
                    <div class="body-title">Oluşturulma Tarihi <span class="tf-color-1">*</span> </div>
                    <input class="flex-grow" asp-for="CreatedDate" type="datetime-local" tabindex="0">
                    <span asp-validation-for="CreatedDate" class="text-danger"></span>
                </fieldset>
                <fieldset class="name">
                    <div class="body-title">Üst Kategori <span class="tf-color-1">*</span> </div>
                    <input class="flex-grow" asp-for="ParentCategoryId" type="number" tabindex="0">
                    <span asp-validation-for="ParentCategoryId" class="text-danger"></span>
                </fieldset>
                <fieldset class="name">
                    <div class="body-title">Aktif - Pasif </div>
                    <div class="wrap-checkbox">
                        <ul class="table-title flex gap20">
                            <li class="countries-item">
                                <div class="flex gap10">
                                    <input type="hidden" asp-for="IsDeleted" value="false" />
                                    <input class="checkbox-item" type="checkbox" asp-for="IsDeleted" value="true">
                                    <label for="IsDeleted">
                                        <div class="body-text">Aktif</div>
                                    </label>
                                </div>
                            </li>
                        </ul>
                    </div>
                </fieldset>
                <div class="bot">
                    <div></div>
                    <button class="tf-button w208" type="submit">Kaydet</button>
                    <a class="tf-button w208" href="/Admin/Category/Index">İptal</a>
                </div>
            </form>
        </div>
        <!-- /new-category -->
    </div>
    <!-- /main-content-wrap -->
</div>
<!-- /main-content-wrap -->