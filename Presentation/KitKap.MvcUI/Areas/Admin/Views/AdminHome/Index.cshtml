@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<!-- main-content-wrap -->
<div class="main-content-wrap">
    <div class="flex items-center flex-wrap justify-between gap20 mb-27">
        <h3>Dashboard</h3>
        <ul class="breadcrumbs flex items-center flex-wrap justify-start gap10">
            <li>
                <a href="@Url.Action("Index", "AdminHome", new { area = "Admin" })">
                    <div class="text-tiny">Dashboard</div>
                </a>
            </li>
            <li>
                <i class="icon-chevron-right"></i>
            </li>
            <li>
                <div class="text-tiny">Ana Sayfa</div>
            </li>
        </ul>
    </div>

    <!-- Genel İstatistikler -->
    <div class="wg-box">
        <div class="flex items-center justify-between gap10 flex-wrap">
            <div class="wg-chart-default mb-20">
                <div class="flex items-center justify-between gap10">
                    <div class="image">
                        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="52" viewBox="0 0 48 52" fill="none">
                            <path d="M19.1094 2.12943C22.2034 0.343099 26.0154 0.343099 29.1094 2.12943L42.4921 9.85592C45.5861 11.6423 47.4921 14.9435 47.4921 18.5162V33.9692C47.4921 37.5418 45.5861 40.8431 42.4921 42.6294L29.1094 50.3559C26.0154 52.1423 22.2034 52.1423 19.1094 50.3559L5.72669 42.6294C2.63268 40.8431 0.726688 37.5418 0.726688 33.9692V18.5162C0.726688 14.9435 2.63268 11.6423 5.72669 9.85592L19.1094 2.12943Z" fill="#22C55E" />
                        </svg>
                        <i class="icon-shopping-bag"></i>
                    </div>
                    <div>
                        <div class="flex items-center justify-between gap10 flex-wrap">
                            <div class="body-text mb-2">Toplam Ürün</div>
                        </div>
                        <h4>@Model.TotalProducts</h4>
                    </div>
                </div>
            </div>

            <div class="wg-chart-default mb-20">
                <div class="flex items-center justify-between gap10">
                    <div class="image">
                        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="52" viewBox="0 0 48 52" fill="none">
                            <path d="M19.1094 2.12943C22.2034 0.343099 26.0154 0.343099 29.1094 2.12943L42.4921 9.85592C45.5861 11.6423 47.4921 14.9435 47.4921 18.5162V33.9692C47.4921 37.5418 45.5861 40.8431 42.4921 42.6294L29.1094 50.3559C26.0154 52.1423 22.2034 52.1423 19.1094 50.3559L5.72669 42.6294C2.63268 40.8431 0.726688 37.5418 0.726688 33.9692V18.5162C0.726688 14.9435 2.63268 11.6423 5.72669 9.85592L19.1094 2.12943Z" fill="#FF5200" />
                        </svg>
                        <i class="icon-file-text"></i>
                    </div>
                    <div>
                        <div class="flex items-center justify-between gap10 flex-wrap">
                            <div class="body-text mb-2">Toplam Sipariş</div>
                        </div>
                        <h4>@Model.TotalOrders</h4>
                    </div>
                </div>
            </div>

            <div class="wg-chart-default mb-20">
                <div class="flex items-center justify-between gap10">
                    <div class="image">
                        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="52" viewBox="0 0 48 52" fill="none">
                            <path d="M19.1094 2.12943C22.2034 0.343099 26.0154 0.343099 29.1094 2.12943L42.4921 9.85592C45.5861 11.6423 47.4921 14.9435 47.4921 18.5162V33.9692C47.4921 37.5418 45.5861 40.8431 42.4921 42.6294L29.1094 50.3559C26.0154 52.1423 22.2034 52.1423 19.1094 50.3559L5.72669 42.6294C2.63268 40.8431 0.726688 37.5418 0.726688 33.9692V18.5162C0.726688 14.9435 2.63268 11.6423 5.72669 9.85592L19.1094 2.12943Z" fill="#2377FC" />
                        </svg>
                        <i class="icon-users"></i>
                    </div>
                    <div>
                        <div class="flex items-center justify-between gap10 flex-wrap">
                            <div class="body-text mb-2">Toplam Kullanıcı</div>
                        </div>
                        <h4>@Model.TotalUsers</h4>
                    </div>
                </div>
            </div>

            <div class="wg-chart-default mb-20">
                <div class="flex items-center justify-between gap10">
                    <div class="image">
                        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="52" viewBox="0 0 48 52" fill="none">
                            <path d="M19.1094 2.12943C22.2034 0.343099 26.0154 0.343099 29.1094 2.12943L42.4921 9.85592C45.5861 11.6423 47.4921 14.9435 47.4921 18.5162V33.9692C47.4921 37.5418 45.5861 40.8431 42.4921 42.6294L29.1094 50.3559C26.0154 52.1423 22.2034 52.1423 19.1094 50.3559L5.72669 42.6294C2.63268 40.8431 0.726688 37.5418 0.726688 33.9692V18.5162C0.726688 14.9435 2.63268 11.6423 5.72669 9.85592L19.1094 2.12943Z" fill="#FFB800" />
                        </svg>
                        <i class="icon-dollar-sign"></i>
                    </div>
                    <div>
                        <div class="flex items-center justify-between gap10 flex-wrap">
                            <div class="body-text mb-2">Toplam Gelir</div>
                        </div>
                        <h4>@Model.TotalRevenue.ToString("N2")₺</h4>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sipariş Durumları -->
        <div class="flex items-center justify-between gap10 flex-wrap mt-20">
            <div class="wg-chart-default">
                <div class="flex items-center justify-between">
                    <div class="body-text">Bekleyen Siparişler</div>
                    <div class="box-icon-trending up">
                        <i class="icon-clock"></i>
                        <div class="body-title number">@Model.PendingOrders</div>
                    </div>
                </div>
            </div>

            <div class="wg-chart-default">
                <div class="flex items-center justify-between">
                    <div class="body-text">İşlemdeki Siparişler</div>
                    <div class="box-icon-trending up">
                        <i class="icon-loader"></i>
                        <div class="body-title number">@Model.ProcessingOrders</div>
                    </div>
                </div>
            </div>

            <div class="wg-chart-default">
                <div class="flex items-center justify-between">
                    <div class="body-text">Tamamlanan Siparişler</div>
                    <div class="box-icon-trending up">
                        <i class="icon-check"></i>
                        <div class="body-title number">@Model.CompletedOrders</div>
                    </div>
                </div>
            </div>

            <div class="wg-chart-default">
                <div class="flex items-center justify-between">
                    <div class="body-text">İptal Edilen Siparişler</div>
                    <div class="box-icon-trending down">
                        <i class="icon-x"></i>
                        <div class="body-title number">@Model.CancelledOrders</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Stok Uyarıları -->
    <div class="wg-box mt-5">
        <div class="flex items-center justify-between">
            <h5>Stok Durumu</h5>
        </div>
        <div class="flex items-center justify-between gap10 flex-wrap mt-20">
            <div class="block-warning w-full">
                <i class="icon-alert-triangle"></i>
                <div>
                    <div class="body-title-2">Düşük Stok Uyarısı</div>
                    <div class="body-text">@Model.LowStockProducts ürünün stoğu azalmakta</div>
                </div>
            </div>

            @if (Model.OutOfStockProducts > 0)
            {
                <div class="block-warning error w-full">
                    <i class="icon-x-circle"></i>
                    <div>
                        <div class="body-title-2">Stokta Yok</div>
                        <div class="body-text">@Model.OutOfStockProducts ürün stokta bulunmuyor</div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Son Ürünler ve Siparişler -->
    <div class="flex gap20 flex-wrap-mobile mt-5">
        <!-- Son Eklenen Ürünler -->
        <div class="wg-box w-half">
            <div class="flex items-center justify-between">
                <h5>Son Eklenen Ürünler</h5>
                <a class="view-all" asp-controller="Product" asp-action="Index">Tümünü Gör</a>
            </div>
            <div class="wg-table table-product-overview mt-20">
                <ul class="table-title flex gap10 mb-14">
                    <li>
                        <div class="body-title">Ürün</div>
                    </li>
                    <li>
                        <div class="body-title">Fiyat</div>
                    </li>
                    <li>
                        <div class="body-title">Stok</div>
                    </li>
                </ul>
                <ul class="flex flex-column">
                    @foreach (var product in Model.RecentProducts)
                    {
                        <li class="product-item gap14">
                            <div class="image small">
                                <img src="@product.ImageUrl" alt="@product.Name">
                            </div>
                            <div class="flex items-center justify-between gap10 flex-grow">
                                <div class="name">
                                    <a asp-controller="Product" asp-action="ProductDetail" asp-route-id="@product.Id" class="body-text">@product.Name</a>
                                </div>
                                <div class="body-text">@product.Price.ToString("N2")₺</div>
                                <div>
                                    @if (product.Stock == 0)
                                    {
                                        <div class="block-not-available">Stokta Yok</div>
                                    }
                                    else if (product.Stock <= 5)
                                    {
                                        <div class="block-warning small">@product.Stock</div>
                                    }
                                    else
                                    {
                                        <div class="body-text">@product.Stock</div>
                                    }
                                </div>
                            </div>
                        </li>
                    }
                </ul>
            </div>
        </div>

        <!-- Son Siparişler -->
        <div class="wg-box w-half">
            <div class="flex items-center justify-between">
                <h5>Son Siparişler</h5>
                <a class="view-all" asp-controller="Order" asp-action="Index">Tümünü Gör</a>
            </div>
            <div class="wg-table table-orders mt-20">
                <ul class="table-title flex gap10 mb-14">
                    <li>
                        <div class="body-title">Müşteri</div>
                    </li>
                    <li>
                        <div class="body-title">Tutar</div>
                    </li>
                    <li>
                        <div class="body-title">Durum</div>
                    </li>
                </ul>
                <ul class="flex flex-column">
                    @foreach (var order in Model.RecentOrders)
                    {
                        <li class="order-item">
                            <div class="body-text">@order.CustomerName</div>
                            <div class="body-text">@order.TotalAmount.ToString("N2")₺</div>
                            <div>
                                @if (order.Status == "Pending")
                                {
                                    <div class="block-status pending">Bekliyor</div>
                                }
                                else if (order.Status == "Processing")
                                {
                                    <div class="block-status processing">İşlemde</div>
                                }
                                else if (order.Status == "Delivered")
                                {
                                    <div class="block-status delivered">Tamamlandı</div>
                                }
                                else if (order.Status == "Cancelled")
                                {
                                    <div class="block-status cancelled">İptal</div>
                                }
                                else
                                {
                                    <div class="block-status">@order.Status</div>
                                }
                            </div>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>
<!-- /main-content-wrap -->