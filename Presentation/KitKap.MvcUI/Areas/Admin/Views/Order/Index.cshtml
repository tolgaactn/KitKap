@using KitKap.MvcUI.ViewModels.OrderViewModels
@model List<OrderListViewModel>
@{
    ViewData["Title"] = "Sipariş Yönetimi";
    var totalCount = ViewData["TotalCount"];
    var selectedStatus = ViewData["SelectedStatus"]?.ToString() ?? "All";
    var searchQuery = ViewData["SearchQuery"]?.ToString() ?? "";
}

<!-- main-content-wrap -->
<div class="main-content-wrap">
    <div class="flex items-center flex-wrap justify-between gap20 mb-27">
        <h3>Sipariş Yönetimi</h3>
        <ul class="breadcrumbs flex items-center flex-wrap justify-start gap10">
            <li>
                <a href="@Url.Action("Index", "AdminHome")">
                    <div class="text-tiny">Dashboard</div>
                </a>
            </li>
            <li><i class="icon-chevron-right"></i></li>
            <li>
                <div class="text-tiny">Siparişler</div>
            </li>
        </ul>
    </div>

    <!-- Filtreler -->
    <div class="wg-box">
        <div class="flex items-center justify-between gap10 flex-wrap">
            <div class="wg-filter flex-grow">
                <form method="get" class="form-search">
                    <fieldset class="name">
                        <input type="text" placeholder="Sipariş ara..." name="search"
                               value="@searchQuery" tabindex="2" aria-required="true">
                    </fieldset>
                    <div class="button-submit">
                        <button type="submit"><i class="icon-search"></i></button>
                    </div>
                </form>
            </div>
            <div class="flex gap10">
                <a class="tf-button style-1 w208 @(selectedStatus == "All" ? "active" : "")"
                   asp-action="Index" asp-route-status="All">
                    <i class="icon-file-text"></i> Tümü (@Model.Count)
                </a>
                <a class="tf-button style-1 w208 @(selectedStatus == "Pending" ? "active" : "")"
                   asp-action="Index" asp-route-status="Pending">
                    <i class="icon-clock"></i> Bekleyen
                </a>
                <a class="tf-button style-1 w208 @(selectedStatus == "Processing" ? "active" : "")"
                   asp-action="Index" asp-route-status="Processing">
                    <i class="icon-loader"></i> İşlemde
                </a>
                <a class="tf-button style-1 w208 @(selectedStatus == "Shipped" ? "active" : "")"
                   asp-action="Index" asp-route-status="Shipped">
                    <i class="icon-truck"></i> Kargoda
                </a>
                <a class="tf-button style-1 w208 @(selectedStatus == "Delivered" ? "active" : "")"
                   asp-action="Index" asp-route-status="Delivered">
                    <i class="icon-check"></i> Teslim Edildi
                </a>
            </div>
        </div>
    </div>

    <!-- Sipariş Listesi -->
    <div class="wg-box mt-5">
        <div class="flex items-center justify-between">
            <h5>Sipariş Listesi</h5>
            <div class="body-text">Toplam: @totalCount sipariş</div>
        </div>

        @if (Model.Any())
        {
            <div class="wg-table table-all-user mt-20">
                <div class="table-responsive">
                    <table class="table table-striped table-bordered">
                        <thead>
                            <tr>
                                <th>Sipariş No</th>
                                <th>Müşteri</th>
                                <th>Ürün Sayısı</th>
                                <th>Tutar</th>
                                <th>Durum</th>
                                <th>Tarih</th>
                                <th>İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="body-title-2">@order.OrderNumber</div>
                                    </td>
                                    <td>
                                        <div class="body-text">@order.CustomerName</div>
                                        <div class="text-tiny mt-3">@order.CustomerEmail</div>
                                    </td>
                                    <td>
                                        <div class="body-text">@order.ItemCount ürün</div>
                                    </td>
                                    <td>
                                        <div class="body-title-2">@order.TotalAmount.ToString("N2")₺</div>
                                    </td>
                                    <td>
                                        @if (order.Status == "Pending")
                                        {
                                            <div class="block-status pending">@order.StatusText</div>
                                        }
                                        else if (order.Status == "Processing")
                                        {
                                            <div class="block-status processing">@order.StatusText</div>
                                        }
                                        else if (order.Status == "Shipped")
                                        {
                                            <div class="block-status shipped">@order.StatusText</div>
                                        }
                                        else if (order.Status == "Delivered")
                                        {
                                            <div class="block-status delivered">@order.StatusText</div>
                                        }
                                        else if (order.Status == "Cancelled")
                                        {
                                            <div class="block-status cancelled">@order.StatusText</div>
                                        }
                                        else
                                        {
                                            <div class="block-status">@order.StatusText</div>
                                        }
                                    </td>
                                    <td>
                                        <div class="body-text">@order.OrderDate.ToString("dd.MM.yyyy")</div>
                                        <div class="text-tiny">@order.OrderDate.ToString("HH:mm")</div>
                                    </td>
                                    <td>
                                        <div class="list-icon-function">
                                            <a asp-action="Detail" asp-route-id="@order.Id"
                                               class="item eye" title="Detay Gör">
                                                <i class="icon-eye"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else
        {
            <div class="no-data">
                <div class="image">
                    <img src="~/admin/images/no-data.png" alt="No Data">
                </div>
                <div class="text-tiny">Sipariş bulunamadı</div>
            </div>
        }
    </div>
</div>
<!-- /main-content-wrap -->