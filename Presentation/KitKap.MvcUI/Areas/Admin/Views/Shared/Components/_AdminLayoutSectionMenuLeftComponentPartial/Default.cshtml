<div class="section-menu-left">
    <div class="box-logo">
        <a asp-controller="Home" asp-action="Index" asp-area="" id="site-logo-inner">
            <img class="" id="logo_header_mobile" alt="" src="/adminTemplate/images/logo/logo.png" data-light="/adminTemplate/images/logo/logo.png" data-dark="/adminTemplate/images/logo/logo-dark.png">
        </a>
        <div class="button-show-hide">
            <i class="icon-menu-left"></i>
        </div>
    </div>
    <div class="section-menu-left-wrap">
        <div class="center">
            @{
                var actionName = ViewContext.RouteData.Values["action"]?.ToString();
                var controllerName = ViewContext.RouteData.Values["controller"]?.ToString();
                var areaName = ViewContext.RouteData.Values["area"]?.ToString();
            }

            <!-- ANA SAYFA -->
            <div class="center-item">
                <div class="center-heading">Ana Sayfa</div>
                <ul class="menu-list">
                    @if (controllerName == "AdminHome" && areaName == "Admin")
                    {
                        <li class="menu-item active">
                            <a asp-area="Admin" asp-controller="AdminHome" asp-action="Index">
                                <div class="icon"><i class="icon-grid"></i></div>
                                <div class="text">Dashboard</div>
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="menu-item">
                            <a asp-area="Admin" asp-controller="AdminHome" asp-action="Index">
                                <div class="icon"><i class="icon-grid"></i></div>
                                <div class="text">Dashboard</div>
                            </a>
                        </li>
                    }
                </ul>
            </div>

            <!-- TÜM SAYFALAR -->
            <div class="center-item">
                <div class="center-heading">Yönetim</div>
                <ul class="menu-list">

                    <!-- ÜRÜNLER -->
                    @if (controllerName == "Product" && areaName == "Admin")
                    {
                        <li class="menu-item has-children active">
                            <a href="javascript:void(0);" class="menu-item-button">
                                <div class="icon"><i class="icon-shopping-cart"></i></div>
                                <div class="text">Ürünler</div>
                            </a>
                            <ul class="sub-menu" style="display: block;">
                                <li class="sub-menu-item">
                                    <a asp-area="Admin" asp-controller="Product" asp-action="Index"
                                       class="@(actionName == "Index" ? "active" : "")">
                                        <div class="text">Ürün Listesi</div>
                                    </a>
                                </li>
                                <li class="sub-menu-item">
                                    <a asp-area="Admin" asp-controller="Product" asp-action="Create"
                                       class="@(actionName == "Create" ? "active" : "")">
                                        <div class="text">Yeni Ürün</div>
                                    </a>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="menu-item has-children">
                            <a href="javascript:void(0);" class="menu-item-button">
                                <div class="icon"><i class="icon-shopping-cart"></i></div>
                                <div class="text">Ürünler</div>
                            </a>
                            <ul class="sub-menu">
                                <li class="sub-menu-item">
                                    <a asp-area="Admin" asp-controller="Product" asp-action="Index">
                                        <div class="text">Ürün Listesi</div>
                                    </a>
                                </li>
                                <li class="sub-menu-item">
                                    <a asp-area="Admin" asp-controller="Product" asp-action="Create">
                                        <div class="text">Yeni Ürün</div>
                                    </a>
                                </li>
                            </ul>
                        </li>
                    }

                    <!-- KATEGORİLER -->
                    @if (controllerName == "Category" && areaName == "Admin")
                    {
                        <li class="menu-item has-children active">
                            <a href="javascript:void(0);" class="menu-item-button">
                                <div class="icon"><i class="icon-layers"></i></div>
                                <div class="text">Kategoriler</div>
                            </a>
                            <ul class="sub-menu" style="display: block;">
                                <li class="sub-menu-item">
                                    <a asp-area="Admin" asp-controller="Category" asp-action="Index"
                                       class="@(actionName == "Index" ? "active" : "")">
                                        <div class="text">Kategori Listesi</div>
                                    </a>
                                </li>
                                <li class="sub-menu-item">
                                    <a asp-area="Admin" asp-controller="Category" asp-action="Create"
                                       class="@(actionName == "Create" ? "active" : "")">
                                        <div class="text">Yeni Kategori</div>
                                    </a>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="menu-item has-children">
                            <a href="javascript:void(0);" class="menu-item-button">
                                <div class="icon"><i class="icon-layers"></i></div>
                                <div class="text">Kategoriler</div>
                            </a>
                            <ul class="sub-menu">
                                <li class="sub-menu-item">
                                    <a asp-area="Admin" asp-controller="Category" asp-action="Index">
                                        <div class="text">Kategori Listesi</div>
                                    </a>
                                </li>
                                <li class="sub-menu-item">
                                    <a asp-area="Admin" asp-controller="Category" asp-action="Create">
                                        <div class="text">Yeni Kategori</div>
                                    </a>
                                </li>
                            </ul>
                        </li>
                    }

                    <!-- SİPARİŞLER -->
                    @if (controllerName == "Order" && areaName == "Admin")
                    {
                        <li class="menu-item has-children active">
                            <a href="javascript:void(0);" class="menu-item-button">
                                <div class="icon"><i class="icon-file-plus"></i></div>
                                <div class="text">Siparişler</div>
                            </a>
                            <ul class="sub-menu" style="display: block;">
                                <li class="sub-menu-item">
                                    <a asp-area="Admin" asp-controller="Order" asp-action="Index"
                                       class="@(actionName == "Index" ? "active" : "")">
                                        <div class="text">Sipariş Listesi</div>
                                    </a>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="menu-item has-children">
                            <a href="javascript:void(0);" class="menu-item-button">
                                <div class="icon"><i class="icon-file-plus"></i></div>
                                <div class="text">Siparişler</div>
                            </a>
                            <ul class="sub-menu">
                                <li class="sub-menu-item">
                                    <a asp-area="Admin" asp-controller="Order" asp-action="Index">
                                        <div class="text">Sipariş Listesi</div>
                                    </a>
                                </li>
                            </ul>
                        </li>
                    }

                    <!-- HAKKINDA -->
                    @if (controllerName == "About" && areaName == "Admin")
                    {
                        <li class="menu-item has-children active">
                            <a href="javascript:void(0);" class="menu-item-button">
                                <div class="icon"><i class="icon-info"></i></div>
                                <div class="text">Hakkımızda</div>
                            </a>
                            <ul class="sub-menu" style="display: block;">
                                <li class="sub-menu-item">
                                    <a asp-area="Admin" asp-controller="About" asp-action="Index"
                                       class="@(actionName == "Index" ? "active" : "")">
                                        <div class="text">Hakkımızda Bilgisi</div>
                                    </a>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="menu-item has-children">
                            <a href="javascript:void(0);" class="menu-item-button">
                                <div class="icon"><i class="icon-info"></i></div>
                                <div class="text">Hakkımızda</div>
                            </a>
                            <ul class="sub-menu">
                                <li class="sub-menu-item">
                                    <a asp-area="Admin" asp-controller="About" asp-action="Index">
                                        <div class="text">Hakkımızda Bilgisi</div>
                                    </a>
                                </li>
                            </ul>
                        </li>
                    }

                </ul>
            </div>

            <!-- AYARLAR -->
            <div class="center-item">
                <div class="center-heading">Sistem</div>
                <ul class="menu-list">
                    <li class="menu-item">
                        <a asp-area="" asp-controller="Home" asp-action="Index">
                            <div class="icon"><i class="icon-external-link"></i></div>
                            <div class="text">Siteye Dön</div>
                        </a>
                    </li>
                    <li class="menu-item">
                        <a asp-area="" asp-controller="Account" asp-action="Logout"
                           onclick="event.preventDefault(); document.getElementById('logout-form').submit();">
                            <div class="icon"><i class="icon-log-out"></i></div>
                            <div class="text">Çıkış Yap</div>
                        </a>
                    </li>
                </ul>
            </div>

        </div>

        <div class="bot text-center">
            <div class="wrap">
                <div class="mb-20">
                    <img src="~/adminTemplate/images/menu-left/img-bot.png" alt="">
                </div>
                <div class="mb-20">
                    <h6>Yardıma mı ihtiyacınız var?</h6>
                    <div class="text">Destek ekibimizle iletişime geçin</div>
                </div>
                <a href="#" class="tf-button w-full">İletişim</a>
            </div>
        </div>
    </div>
</div>

<!-- Logout Form -->
<form id="logout-form" asp-area="" asp-controller="Account" asp-action="Logout" method="post" style="display: none;">
    @Html.AntiForgeryToken()
</form>