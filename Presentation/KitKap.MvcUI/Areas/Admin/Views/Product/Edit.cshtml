@model EditProductViewModel

@{
    ViewData["Title"] = "Ürünü Düzenle";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2>Ürünü Düzenle</h2>

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="OwnerId" />
    <input type="hidden" asp-for="Status" />
    <input type="hidden" asp-for="IsDeleted" />

    <div class="form-group">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Description"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Price"></label>
        <input asp-for="Price" type="number" class="form-control" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Stock"></label>
        <input asp-for="Stock" type="number" class="form-control" />
        <span asp-validation-for="Stock" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="CategoryId">Kategori</label>
        <select asp-for="CategoryId" class="form-control" asp-items="ViewBag.Categories"></select>
    </div>

    <div class="form-group">
        <label>Mevcut Görseller</label>
        <div class="row">
            @if (Model.ExistingImages != null && Model.ExistingImages.Any())
            {
                foreach (var image in Model.ExistingImages)
                {
                    <div class="col-md-3 text-center mb-3">
                        <img src="@image.ImageUrl" class="img-thumbnail" style="height: 150px;" />

                        <div class="form-check mt-2">
                            <input asp-for="SelectedMainImageId"
                                   class="form-check-input"
                                   type="radio"
                                   value="@image.Id"
                                   checked="@(image.IsMain ? "checked" : null)" />
                            <label class="form-check-label">Ana Görsel Yap</label>
                        </div>

                        <div class="form-check mt-2">
                            <input class="form-check-input" type="checkbox" name="ImagesToDelete" value="@image.Id" />
                            <label class="form-check-label text-danger">Sil</label>
                        </div>
                    </div>
                }
            }
            else
            {
                <p>Ürüne ait görsel bulunmamaktadır.</p>
            }
        </div>
    </div>

    <div class="form-group mt-4">
        <label>Yeni Görseller Yükle</label>
        <input asp-for="NewProductImages" type="file" multiple class="form-control" />
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-success">Kaydet</button>
        <a asp-action="Index" class="btn btn-secondary">İptal</a>
    </div>
</form>
