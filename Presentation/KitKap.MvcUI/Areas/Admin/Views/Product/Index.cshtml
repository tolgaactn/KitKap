@model List<GetAllProductViewModel>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<!-- main-content-wrap -->
<div class="main-content-inner">
    <!-- main-content-wrap -->
    <div class="main-content-wrap">
        <div class="flex items-center flex-wrap justify-between gap20 mb-27">
            <h3>Ürün Listesi</h3>
            <ul class="breadcrumbs flex items-center flex-wrap justify-start gap10">
                <li>
                    <a href="/Admin/AdminHome/Index"><div class="text-tiny">Anasayfa</div></a>
                </li>
                <li>
                    <i class="icon-chevron-right"></i>
                </li>
                <li>
                    <a href="#"><div class="text-tiny">E-Ticaret</div></a>
                </li>
                <li>
                    <i class="icon-chevron-right"></i>
                </li>
                <li>
                    <div class="text-tiny">Ürün Listesi</div>
                </li>
            </ul>
        </div>
        <!-- all-roles -->
        <div class="wg-box">
            <div class="flex items-center justify-between gap10 flex-wrap">
                <div class="wg-filter flex-grow">
                    <form method="get" asp-area="Admin" asp-controller="Product" asp-action="Index" class="form-search">
                        <fieldset class="name">
                            <input type="search" placeholder="No veya Ürün Adı Ara" class="" name="search" tabindex="2" value="" aria-required="true" required="">
                        </fieldset>
                        <div class="button-submit">
                            <button class="" type="submit"><i class="icon-search"></i></button>
                        </div>
                    </form>
                </div>
                <a class="tf-button style-1 w208" href="/Admin/Product/Create"><i class="icon-plus"></i>Yeni Ürün Ekle</a>
            </div>
            <div class="wg-table table-product-list">
                <ul class="table-title flex gap20 mb-14">
                    <li>
                        <div class="body-title">Ürün Adı</div>
                    </li>
                    <li>
                        <div class="body-title">Ürün ID</div>
                    </li>
                    <li>
                        <div class="body-title">Fiyat</div>
                    </li>
                    <li>
                        <div class="body-title">Stok</div>
                    </li>
                    <li>
                        <div class="body-title">Satışta</div>
                    </li>
                    <li>
                        <div class="body-title">Kategorisi</div>
                    </li>
                    <li>
                        <div class="body-title">Eylem</div>
                    </li>
                </ul>
                <ul class="flex flex-column">
                    @foreach (var product in Model)
                    {
                        <li class="product-item gap14">
                            <!-- Ürün Görseli -->
                            <div class="image no-bg">
                                <img src="@product.ImageUrl" alt="" style="width: 40px; height: 40px; object-fit: cover;">
                            </div>

                            <!-- Diğer Bilgiler (hepsi tek 'flex' içinde) -->
                            <div class="flex items-center justify-between gap20 flex-grow">
                                <div class="name">
                                    <a asp-controller="Product" asp-action="ProductDetail" asp-route-id="@product.Id" class="body-title-2">@product.Name</a>
                                </div>
                                <div class="body-text">@product.Id</div>
                                <div class="body-text">@product.Price</div>
                                <div class="body-text">@product.Stock</div>
                                <div class="body-text">@product.Status</div>
                                <div class="body-text">@product.CategoryName</div>

                                <!-- Butonlar -->
                                <div class="list-icon-function">
                                   <a class="item eye" asp-controller="Product" asp-action="ProductDetail" asp-route-id="@product.Id">
                                        <i class="icon-eye"></i>
                                    </a>
                                    <a class="item edit" asp-controller="Product" asp-action="Edit" asp-route-id="@product.Id">
                                        <i class="icon-edit-3"></i>
                                    </a>
                                    <form method="post" asp-action="Delete" asp-controller="Product" asp-area="Admin" asp-route-id="@product.Id" onsubmit="return confirm('Bu kategoriyi silmek istediğinizden emin misiniz?');">

                                        <button type="submit" class="btn btn-danger">
                                            <i class="icon-trash-2"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </li>
                    }
                </ul>
            </div>
            <div class="divider"></div>
            <div class="flex items-center justify-between flex-wrap gap10">
                <div class="text-tiny">@ViewData["TotalCount"] Kayıttan @Model.Count() Tanesi Gösteriliyor</div>
                <ul class="wg-pagination">
                    <li>
                        <a href="#"><i class="icon-chevron-left"></i></a>
                    </li>
                    <li class="active">
                        <a asp-controller="Product" asp-action="Index">1</a>
                    </li>
                    <li>
                        <a href="#">2</a>
                    </li>
                    <li>
                        <a href="#">3</a>
                    </li>
                    <li>
                        <a href="#"><i class="icon-chevron-right"></i></a>
                    </li>
                </ul>
            </div>
        </div>
        <!-- /all-roles -->
    </div>
    <!-- /main-content-wrap -->
</div>
<!-- /main-content-wrap -->
