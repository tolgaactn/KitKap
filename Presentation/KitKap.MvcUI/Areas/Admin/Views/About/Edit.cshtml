@model AboutViewModel

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<!-- main-content-wrap -->
<div class="main-content-inner">
    <!-- main-content-wrap -->
    <div class="main-content-wrap">
        <div class="flex items-center flex-wrap justify-between gap20 mb-27">
            <h3>Hakkında Düzenle</h3>
            <ul class="breadcrumbs flex items-center flex-wrap justify-start gap10">
                <li>
                    <a href="/Admin/AdminHome/Index"><div class="text-tiny">Anasayfa</div></a>
                </li>
                <li>
                    <i class="icon-chevron-right"></i>
                </li>
                <li>
                    <a href="#"><div class="text-tiny">Hakkında</div></a>
                </li>
                <li>
                    <i class="icon-chevron-right"></i>
                </li>
                <li>
                    <div class="text-tiny">Hakkında Listesi</div>
                </li>
            </ul>
        </div>
        <!-- new-attribute -->
        <div class="wg-box">
            <form class="form-new-product form-style-1" asp-action="Edit" asp-controller="About" asp-area="Admin" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <fieldset class="name">
                    <div class="body-title">Id <span class="tf-color-1">*</span> </div>
                    <input class="flex-grow" asp-for="AboutId" type="text" tabindex="0">
                    <span asp-validation-for="AboutId" class="text-danger"></span>
                </fieldset>
                <fieldset class="name">
                    <div class="body-title">Açıklama <span class="tf-color-1">*</span> </div>
                    <textarea class="flex-grow" asp-for="Description" placeholder="Açıklama" tabindex="0" aria-required="true" required=""></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </fieldset>
                <fieldset class="name">
                    <div class="body-title">Adres <span class="tf-color-1">*</span> </div>
                    <input class="flex-grow" asp-for="Address" type="text" tabindex="0">
                    <span asp-validation-for="Address" class="text-danger"></span>
                </fieldset>
                <fieldset class="name">
                    <div class="body-title">E-mail <span class="tf-color-1">*</span> </div>
                    <input class="flex-grow" asp-for="Email" type="email" tabindex="0">
                    <span asp-validation-for="Email" class="text-danger"></span>
                </fieldset>
                <fieldset class="name">
                    <div class="body-title">Telefon <span class="tf-color-1">*</span> </div>
                    <input class="flex-grow" asp-for="Phone" type="text" tabindex="0">
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </fieldset>
                <div class="bot">
                    <div></div>
                    <button class="tf-button w208" type="submit">Kaydet</button>
                    <a class="tf-button w208" href="/Admin/About/Index">İptal</a>
                </div>
            </form>
        </div>
        <!-- /new-category -->
    </div>
    <!-- /main-content-wrap -->
</div>
<!-- /main-content-wrap -->

